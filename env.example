# Copy to .env.local for local dev. On Netlify, set these under
# Site configuration → Environment variables, then redeploy.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional. If set, the admin view is read-only until this PIN is entered.
# It ships inside the JS bundle, so it's a speed bump, not real security.
VITE_ADMIN_PIN=
